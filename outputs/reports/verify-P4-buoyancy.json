    {
      "id": "hook",
      "title": "铁块沉底，轮船却能浮",
      "objective": "暴露“重就下沉”的错误直觉",
      "start": 0,
      "duration": 14,
      "visual": "左侧铁块下沉、右侧轮船漂浮；同一材质对比",
      "motion": "铁块下沉动画与轮船轻微起伏对比，问号出现",
      "camera": "固定机位",
      "link": "用矛盾现象引出浮力",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "一块铁放进水里会沉底。"
        },
        {
          "t": 4.2,
          "text": "可钢铁造的大轮船，却能浮在水面上。"
        },
        {
          "t": 8.4,
          "text": "难道重的物体反而更容易浮起来？"
        },
        {
          "t": 11.6,
          "text": "关键不在轻重，而在它排开了多少水。"
        }
      ]
    },
    {
      "id": "weigh",
      "title": "称重法测浮力",
      "objective": "掌握 F浮 = G − F示，理解示数变小的原因",
      "start": 14,
      "duration": 22,
      "visual": "弹簧测力计悬挂物体，浸入水中后示数变小；受力分析图",
      "motion": "物体浸入，测力计示数从 8 N 降到 6 N；三个力的箭头出现",
      "camera": "固定机位",
      "link": "给出可测量的定义",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "用弹簧测力计挂着物体，先读出示数 8 牛，这就是重力。"
        },
        {
          "t": 5.6,
          "text": "把物体浸入水中，示数变成 6 牛。"
        },
        {
          "t": 10.4,
          "text": "示数变小，是因为水给了物体一个向上的浮力。"
        },
        {
          "t": 15,
          "text": "所以 F浮 等于重力减去示数，等于 2 牛。"
        }
      ]
    },
    {
      "id": "explore",
      "title": "浮力与什么有关",
      "objective": "通过控制变量得出：浮力随 V排 增大而增大，浸没后与深度无关",
      "start": 36,
      "duration": 28,
      "visual": "左侧物体逐渐浸入，右侧 F–h 图像先上升后水平",
      "motion": "物体下降，示数下降；图像同步描点，浸没后曲线变平",
      "camera": "固定机位",
      "link": "把定义变成定量规律",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "把物体慢慢浸入水中，观察示数。"
        },
        {
          "t": 5,
          "text": "浸入越多，排开的水越多，浮力越大。"
        },
        {
          "t": 10.6,
          "text": "完全浸没后，再往下沉，示数不再变化。"
        },
        {
          "t": 16.4,
          "text": "说明浸没后，浮力与深度无关。"
        },
        {
          "t": 21.4,
          "text": "换成盐水，同样的体积，浮力更大。"
        }
      ]
    },
    {
      "id": "principle",
      "title": "阿基米德原理",
      "objective": "理解 F浮 = G排，会用公式计算",
      "start": 64,
      "duration": 24,
      "visual": "物体排开的水流入小桶，小桶中水的重力与浮力数值相等",
      "motion": "溢出的水流入小桶，数值对比",
      "camera": "固定机位",
      "link": "从定性走向定量",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "阿基米德发现：浮力等于排开液体所受的重力。"
        },
        {
          "t": 5.4,
          "text": "也就是 F浮 = G排。"
        },
        {
          "t": 9.8,
          "text": "写成公式：F浮 = ρ液 g V排。"
        },
        {
          "t": 14.6,
          "text": "ρ液 是液体密度，V排 是排开液体的体积。"
        },
        {
          "t": 19.2,
          "text": "1 升水重约 10 牛，排开 1 升就受 10 牛浮力。"
        }
      ]
    },
    {
      "id": "float",
      "title": "浮沉条件与轮船",
      "objective": "掌握 F浮 与 G 的三种关系，解释轮船与潜水艇",
      "start": 88,
      "duration": 26,
      "visual": "三个物体：上浮、悬浮、下沉；轮船与潜水艇示意",
      "motion": "三个物体分别向上、悬停、向下，标注受力关系",
      "camera": "固定机位",
      "link": "原理用于判断浮沉",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "F浮 大于 G，物体上浮，最后漂浮。"
        },
        {
          "t": 5.4,
          "text": "F浮 等于 G，物体可以悬浮在任何深度。"
        },
        {
          "t": 10.4,
          "text": "F浮 小于 G，物体下沉。"
        },
        {
          "t": 15.4,
          "text": "轮船做成空心，增大 V排，从而获得更大浮力。"
        },
        {
          "t": 20.4,
          "text": "潜水艇靠充水和排水，改变自身重力。"
        }
      ]
    },
    {
      "id": "summary",
      "title": "三句话收尾",
      "objective": "固化称重法、阿基米德原理与浮沉条件",
      "start": 114,
      "duration": 12,
      "visual": "三张要点卡片",
      "motion": "按字幕节拍出现",
      "camera": "固定机位",
      "link": "收束全课",
      "check": "",
      "captions": [
