        },
        {
          "t": 4.6,
          "text": "减少的那部分物质，去哪了？"
        },
        {
          "t": 8.6,
          "text": "是消失了，还是变成了别的东西？"
        },
        {
          "t": 11.6,
          "text": "先别猜，用天平来回答。"
        }
      ]
    },
    {
      "id": "experiment",
      "title": "两个定量实验",
      "objective": "通过密闭体系实验看到反应前后总质量不变",
      "start": 14,
      "duration": 26,
      "visual": "左：密闭锥形瓶内红磷燃烧，放在天平上；右：铁钉插入硫酸铜溶液",
      "motion": "天平示数出现，点燃后白烟生成，冷却后示数保持不变；右杯颜色变化但质量不变",
      "camera": "固定机位",
      "link": "用实验事实回答“质量去哪了”",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "第一个实验：锥形瓶里放红磷，瓶口系气球，整套放在天平上。"
        },
        {
          "t": 6,
          "text": "点燃红磷，产生大量白烟。"
        },
        {
          "t": 11.4,
          "text": "冷却后再称，质量没有变化。"
        },
        {
          "t": 16,
          "text": "第二个实验：铁钉放入硫酸铜溶液。"
        },
        {
          "t": 20.4,
          "text": "铁钉表面变红，溶液变色，总质量仍然不变。"
        }
      ]
    },
    {
      "id": "micro",
      "title": "微观：原子只是重新组合",
      "objective": "从原子种类、数目、质量不变解释质量守恒",
      "start": 40,
      "duration": 26,
      "visual": "左侧反应前 4 个磷原子与 5 个氧分子；右侧反应后 2 个五氧化二磷分子",
      "motion": "原子沿路径迁移重排，计数板数字保持不变",
      "camera": "固定机位",
      "link": "从宏观事实进入微观解释",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "化学变化的本质，是原子重新组合。"
        },
        {
          "t": 4.6,
          "text": "反应前有 4 个磷原子、10 个氧原子。"
        },
        {
          "t": 10,
          "text": "反应后，它们重新组合成 2 个五氧化二磷分子。"
        },
        {
          "t": 15.6,
          "text": "原子的种类没变，数目没变，质量也没变。"
        },
        {
          "t": 21,
          "text": "所以反应前后总质量必然相等。"
        }
      ]
    },
    {
      "id": "equation",
      "title": "方程式为什么必须配平",
      "objective": "理解配平的依据是原子守恒，学会用原子计数检查方程式",
      "start": 66,
      "duration": 22,
      "visual": "4P + 5O₂ →(点燃) 2P₂O₅ 与逐元素计数表",
      "motion": "方程式出现，原子计数表逐行填入，未配平的错误写法对照",
      "camera": "固定机位",
      "link": "把守恒用于化学用语",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "红磷燃烧的方程式：4P 加 5O₂，点燃生成 2P₂O₅。"
        },
        {
          "t": 5.4,
          "text": "检查磷原子：左边 4 个，右边 2 乘 2 也是 4 个。"
        },
        {
          "t": 10.6,
          "text": "检查氧原子：左边 5 乘 2 是 10 个，右边 2 乘 5 也是 10 个。"
        },
        {
          "t": 15.6,
          "text": "如果不配平，两边原子数不等，就违背了质量守恒。"
        }
      ]
    },
    {
