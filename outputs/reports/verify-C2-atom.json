    {
      "id": "hook",
      "title": "物质由什么构成",
      "objective": "建立“物质→分子→原子”的尺度递进，引出原子内部还有结构",
      "start": 0,
      "duration": 12,
      "visual": "水滴 → 水分子 → 氢氧原子 → 原子内部，逐级放大",
      "motion": "三级放大依次推进，最后停在原子内部结构上",
      "camera": "固定机位",
      "link": "从宏观尺度进入微观尺度",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "一滴水，可以分成许多水分子。"
        },
        {
          "t": 4.4,
          "text": "一个水分子，由氢原子和氧原子构成。"
        },
        {
          "t": 8,
          "text": "那么原子本身，还能再分吗？"
        }
      ]
    },
    {
      "id": "models",
      "title": "原子模型的三次演变",
      "objective": "了解模型随证据更新，理解卢瑟福核式模型来自 α 散射实验",
      "start": 12,
      "duration": 26,
      "visual": "三个模型并排：实心球、枣糕、核式；下方 α 粒子散射示意",
      "motion": "三个模型依次出现；散射实验中大部分粒子直穿、少数偏转",
      "camera": "固定机位",
      "link": "用科学史说明模型是如何被修正的",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "1803 年，道尔顿认为原子是不可分割的实心球。"
        },
        {
          "t": 6,
          "text": "1897 年，汤姆孙发现电子，提出“枣糕模型”。"
        },
        {
          "t": 12,
          "text": "1911 年，卢瑟福用 α 粒子轰击金箔。"
        },
        {
          "t": 18,
          "text": "大多数粒子直接穿过，少数发生大角度偏转。"
        },
        {
          "t": 22.6,
          "text": "说明原子内部很空，中心有一个很小的核。"
        }
      ]
    },
    {
      "id": "nucleus",
      "title": "原子核与核外电子",
      "objective": "说出原子核由质子和中子构成，明确三种粒子的电性",
      "start": 38,
      "duration": 22,
      "visual": "原子剖面：中心核（质子+中子），外层电子；右侧粒子属性表",
      "motion": "核与电子出现，质子和中子分别标出，属性逐条出现",
      "camera": "固定机位",
      "link": "从模型进入构成",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "原子由原子核和核外电子构成。"
        },
        {
          "t": 5,
          "text": "原子核里有质子（带正电）和中子（不带电）。"
        },
        {
          "t": 10.6,
          "text": "核外电子带负电，绕核运动。"
        },
        {
          "t": 15.4,
          "text": "原子核很小，却集中了几乎全部质量。"
        }
      ]
    },
    {
      "id": "numbers",
      "title": "三个数，其实相等",
      "objective": "掌握核电荷数=质子数=核外电子数=原子序数，并会用于判断",
      "start": 60,
      "duration": 20,
      "visual": "钠原子数据卡：质子 11、中子 12、电子 11；等式链逐段点亮",
      "motion": "三个数字依次高亮，等式链连接，原子序数出现",
      "camera": "固定机位",
      "link": "把构成落到数量关系",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "以钠原子为例：质子 11 个，中子 12 个，电子 11 个。"
        },
        {
          "t": 6,
          "text": "质子数决定了它是不是钠，也决定原子序数。"
        },
        {
          "t": 11,
          "text": "因为是原子，质子数等于核外电子数，所以不带电。"
        },
        {
          "t": 16,
          "text": "核电荷数、质子数、电子数、原子序数，四个数相等。"
        }
      ]
    },
