    {
      "id": "proof",
      "title": "四个三角形拼出的证明",
      "objective": "用面积法证明 a²+b²=c²，理解代数恒等式的几何来源",
      "start": 36,
      "duration": 30,
      "visual": "边长 a+b 的大正方形，四个全等直角三角形，中间倾斜的 c² 正方形",
      "motion": "大正方形出现，四个三角形依次填充，中间正方形高亮，等式逐行推导",
      "camera": "固定机位",
      "link": "从“数出来”升级为“证出来”",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "用四个一样的直角三角形，拼成一个大正方形。"
        },
        {
          "t": 5.6,
          "text": "大正方形的边长是 a 加 b，面积是 (a+b)²。"
        },
        {
          "t": 11.4,
          "text": "四个三角形的面积合计是 4 乘二分之一 ab，也就是 2ab。"
        },
        {
          "t": 17.4,
          "text": "中间空出的正方形，边长是 c，面积是 c²。"
        },
        {
          "t": 22.8,
          "text": "所以 a² + 2ab + b² = 2ab + c²，两边消去 2ab。"
        },
        {
          "t": 27.4,
          "text": "得到 a² + b² = c²。"
        }
      ]
    },
