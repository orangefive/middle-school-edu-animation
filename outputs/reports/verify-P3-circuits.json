  "scenes": [
    {
      "id": "hook",
      "title": "两个灯泡，两种接法",
      "objective": "直观区分“一条路径”和“多条路径”两种连接",
      "start": 0,
      "duration": 12,
      "visual": "左右两个简单电路：串联一条回路，并联两条支路",
      "motion": "先画串联，电流沿单一回路流动；再画并联，电流分成两支",
      "camera": "固定机位",
      "link": "用路径差异定义两种连接",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "两个灯泡，可以接成一条路径，也可以接成两条。"
        },
        {
          "t": 4.8,
          "text": "一条路径，叫串联；两条路径，叫并联。"
        },
        {
          "t": 9,
          "text": "区别的关键，是电流有没有分叉。"
        }
      ]
    },
    {
      "id": "series",
      "title": "串联：一条路径走到底",
      "objective": "掌握串联电流处处相等、电压分配、电阻相加",
      "start": 12,
      "duration": 26,
      "visual": "串联电路，电流箭头沿回路移动；两点电流表读数相同；电压分配条",
      "motion": "电流光点沿回路运动；两个电流值同步显示；电压条按电阻分配",
      "camera": "固定机位",
      "link": "先讲清串联的三条规律",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "串联电路只有一条路径，电流处处相等。"
        },
        {
          "t": 5.4,
          "text": "所以 I = I₁ = I₂，流过每个用电器的电流都一样。"
        },
        {
          "t": 10.6,
          "text": "总电压等于各部分电压之和：U = U₁ + U₂。"
        },
        {
          "t": 15.8,
          "text": "总电阻等于各电阻之和：R = R₁ + R₂。"
        },
        {
          "t": 20.8,
          "text": "所以串联的总电阻，比任何一个都大。"
        }
      ]
    },
    {
      "id": "parallel",
      "title": "并联：电流分成几路",
      "objective": "掌握并联电压相等、电流分配、等效电阻小于支路",
      "start": 38,
      "duration": 28,
      "visual": "并联电路，电流在节点分流；两条支路电压相同；电流分配条",
      "motion": "电流光点在节点分开，沿两条支路流动；电压标签同时出现",
      "camera": "固定机位",
      "link": "与串联形成对照",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "并联电路中，电流从节点分成两条路径。"
        },
        {
          "t": 5.6,
          "text": "两条支路的两端都接在同一对节点上。"
        },
        {
          "t": 10.8,
          "text": "所以各支路电压相等：U = U₁ = U₂。"
        },
        {
          "t": 16,
          "text": "干路电流等于各支路电流之和：I = I₁ + I₂。"
        },
        {
          "t": 21.4,
          "text": "等效电阻的倒数等于各支路倒数之和。"
        }
      ]
    },
    {
      "id": "compare",
      "title": "串并联对比",
      "objective": "用一张表固化串并联在电流、电压、电阻、开关控制上的差异",
      "start": 66,
      "duration": 18,
      "visual": "四行对比表",
      "motion": "表格逐行出现，关键差异高亮",
      "camera": "固定机位",
      "link": "把两条规律并置记忆",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "把两者放在一起看，差别很清楚。"
        },
        {
          "t": 4.4,
          "text": "串联电流相等、电压分配；并联电压相等、电流分配。"
        },
        {
          "t": 10,
          "text": "串联电阻相加，并联等效电阻更小。"
        },
        {
          "t": 14.2,
          "text": "串联开关控制全部，并联干路开关控制全部、支路开关只管自己。"
        }
      ]
    },
