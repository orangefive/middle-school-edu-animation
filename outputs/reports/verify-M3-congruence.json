      "link": "给出严格的记法与性质",
      "check": "",
      "captions": [
        {
          "t": 0.2,
          "text": "记作 △ABC 全等于 △DEF，字母顺序必须对应。"
        },
        {
          "t": 5,
          "text": "A 对 D，B 对 E，C 对 F。"
        },
        {
          "t": 9.2,
          "text": "对应边相等，对应角也相等。"
        },
        {
          "t": 13.6,
          "text": "所以写全等时，顺序不能随便换。"
        }
      ]
